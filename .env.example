# Base de Datos
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clinicain
# Rol de la aplicacion (permisos minimos, ver migrations/103_rol_sysclin_app.sql)
DB_USER=sysclin_app
DB_PASSWORD=
# Administracion (superusuario): contenedor db en instalacion nueva, backup y migraciones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=clinicain

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# Obligatoria, minimo 32 caracteres: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 solo con HTTPS (servidor); 0 en local para usar el puerto 5005 por HTTP
SESSION_COOKIE_SECURE=0

# WhatsApp Notifications (Ultramsg) - opcional
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Correo saliente (MFA, recordatorios, facturas) - opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
